<Window x:Class="PromptStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="提示词工作台" Icon="PromptStudio.ico" Width="820" Height="638" MinWidth="590" MinHeight="490"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#F5F5F7"
        FontFamily="Noto Sans SC, Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="#1D1D1F"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1D1D1F" />
        <SolidColorBrush x:Key="Muted" Color="#5C6068" />
        <SolidColorBrush x:Key="Accent" Color="#0059BD" />
        <SolidColorBrush x:Key="Line" Color="#E6E7EB" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="UserBubble" Color="#E8EFFA" />
        <Style x:Key="Focus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate><Border CornerRadius="6" BorderBrush="#2674CB" BorderThickness="1" Margin="-3" /></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#ECEDEF" />
            <Setter Property="BorderBrush" Value="#ECEDEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#8CB9EA" />
                                <Setter TargetName="Frame" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0064D2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#0064D2" />
        </Style>
        <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Width" Value="31" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#E8EFFA" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleFrame" Background="#FFFFFF" BorderBrush="#ECEDEF" BorderThickness="1" CornerRadius="7" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="#8CB9EA" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ToggleFrame" Property="BorderBrush" Value="#8CB9EA" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                              Margin="10,0,25,0" VerticalAlignment="Center" />
                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Accent}" StrokeThickness="1.4"
                                  IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,11,0" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Padding="4" Background="#FFFFFF"
                                        BorderBrush="#DFE2E8" BorderThickness="1" CornerRadius="7">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="#A9CDF9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#BAC0C9" CornerRadius="2" Margin="3,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template><ControlTemplate><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#DBDDE3" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="55" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="37" />
            </Grid.RowDefinitions>
            <Border Background="#FDFCFE" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel Margin="19,0,11,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="LibraryButton" Content="提示词库" FontSize="12" Padding="9,4" Margin="0,0,8,0"
                                ToolTip="提示词库  (Ctrl + K)" Click="ToggleLibrary"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <ComboBox x:Name="Scenario" Width="107" Height="32" FontSize="12" Margin="0,0,8,0"
                                  AutomationProperties.Name="优化场景" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button x:Name="NewButton" Content="＋ 新建" FontSize="12" Padding="9,4" Click="NewConversation"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Border Background="{StaticResource Line}" Width="1" Height="21" Margin="12,0,5,0" />
                        <Button Style="{StaticResource Caption}" Click="MinimizeClick" AutomationProperties.Name="最小化">
                            <Path Data="M 0 0 H 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                        <Button Style="{StaticResource Caption}" Click="MaximizeClick" AutomationProperties.Name="最大化或还原">
                            <Path Data="M 0 0 H 8 V 8 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                        <Button Style="{StaticResource Caption}" Click="CloseClick" AutomationProperties.Name="关闭">
                            <Path Data="M 0 0 L 8 8 M 8 0 L 0 8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="29" Height="29" CornerRadius="7" Background="#E9F1FC" BorderBrush="#E9F1FC" BorderThickness="1" Margin="0,0,9,0">
                            <Path Data="M 1 1 H 13 V 10 H 7 L 3 13 V 10 H 1 Z M 4 4 H 10 M 4 7 H 8" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="提示词工作台" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="ConversationArea" Grid.Row="1">
                <StackPanel x:Name="Welcome" MaxWidth="470" Margin="28,0,28,12" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="15" Background="#FFFFFF" BorderBrush="#E5E7EB"
                            BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="M 10 2 H 30 A 4 4 0 0 1 34 6 V 22 A 4 4 0 0 1 30 26 H 19 L 11 32 V 26 H 10 A 4 4 0 0 1 6 22 V 6 A 4 4 0 0 1 10 2 Z M 13 11 H 26 M 13 17 H 22"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="把想法写成提示词" FontSize="32" FontWeight="Medium" Margin="0,17,0,0"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                    <TextBlock Text="描述你想完成的事，或粘贴一段已有的提示词。"
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,10,0,0" LineHeight="23" />
                </StackPanel>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel MaxWidth="656" Margin="27,23,27,14">
                        <StackPanel x:Name="Messages" />
                        <WrapPanel x:Name="Options" Visibility="Collapsed" Margin="12,0,0,12" />
                        <Border x:Name="BriefPanel" Visibility="Collapsed" BorderBrush="#E0E3E9" Background="#FFFFFF"
                                BorderThickness="1" CornerRadius="13" Padding="17,15" Margin="0,1,0,14">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="DetectedScenario" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="确认需求" FontSize="16" FontWeight="SemiBold" />
                                </DockPanel>
                                <TextBlock x:Name="Brief" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,7,0,10" />
                                <Button x:Name="GenerateButton" Content="确认并生成" HorizontalAlignment="Left"
                                        Style="{StaticResource Primary}" IsEnabled="False" Click="GenerateClick" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ResultPanel" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="#DCDFE6"
                                BorderThickness="1" CornerRadius="13" Margin="0,0,0,4">
                            <StackPanel>
                                <Border Background="#FBFBFC" CornerRadius="12,12,0,0" Padding="16,9" BorderBrush="#EDF0F4" BorderThickness="0,0,0,1">
                                    <DockPanel>
                                        <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="复制" IsEnabled="False" Click="CopyClick" MinHeight="28" Padding="10,3" FontSize="12" />
                                        <TextBlock Text="优化后的提示词" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <TextBox x:Name="Result" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="15" Padding="17,13,17,16"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="优化后的提示词" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border x:Name="Composer" Grid.Row="2" MaxWidth="656" Margin="27,4,27,0" Background="{StaticResource Surface}" BorderThickness="1" CornerRadius="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#E0E2E7" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#729DCD" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="11,5,10,8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="Entry" AcceptsReturn="True" TextWrapping="Wrap" FontSize="15" VerticalScrollBarVisibility="Auto"
                             Height="65" Padding="2,6" TextChanged="EntryChanged" PreviewKeyDown="EntryKeyDown"
                             AutomationProperties.Name="描述需求或回复问题" />
                    <TextBlock x:Name="EntryHint" Text="描述你想完成的事…" Foreground="{StaticResource Muted}" Margin="2,7,0,0" IsHitTestVisible="False" />
                    <DockPanel Grid.Row="1" Margin="1,1,0,0">
                        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="开始梳理  ↑" Style="{StaticResource Primary}"
                                MinWidth="87" Click="SendClick" IsEnabled="False" />
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="停止" Margin="0,0,7,0" Click="CancelClick" Visibility="Collapsed" />
                        <TextBlock Text="Ctrl + Enter 发送" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </Border>

            <DockPanel x:Name="ConversationFooter" Grid.Row="3" MaxWidth="656" Margin="27,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse Width="6" Height="6" Fill="#6D7786" Margin="0,0,7,0" />
                    <TextBlock Text="GPT‑6 Luna" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <Grid x:Name="LibraryView" Grid.Row="1" Grid.RowSpan="3" Margin="24,19,24,15" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="提示词库" FontSize="24" FontWeight="Medium" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Margin="0,0,0,12">
                    <Grid>
                        <TextBox x:Name="LibrarySearch" Padding="12,7" AutomationProperties.Name="搜索提示词" TextChanged="LibrarySearchChanged" />
                        <TextBlock x:Name="SearchHint" Text="搜索标题、标签或关键词" Foreground="{StaticResource Muted}"
                                   Margin="12,7" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150" MaxWidth="270" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="11" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="4">
                        <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0"
                                 AutomationProperties.Name="提示词搜索结果"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LibrarySelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#F5F5F7" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="#E8EFFA" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Categories}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="11" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="13,9">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TemplateTitle" FontSize="17" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBox x:Name="TemplatePreview" Grid.Row="1" Padding="0,6,2,4" FontSize="14" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="模板预览" />
                        </Grid>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button x:Name="UseTemplateButton" DockPanel.Dock="Right" Content="填入对话" Style="{StaticResource Primary}"
                            IsEnabled="False" Click="UseTemplate" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,8,0" TextTrimming="CharacterEllipsis">
                        <Run x:Name="LibraryCount" />
                        <Run Text=" · " />
                        <Hyperlink Click="OpenAiShort" Foreground="{StaticResource Accent}">AiShort</Hyperlink>
                        <Run x:Name="OriginalSeparator" Text=" · " />
                        <Hyperlink x:Name="TemplateSource" Click="OpenTemplateSource" Foreground="{StaticResource Accent}">
                            <Run x:Name="OriginalLabel" Text="原出处" />
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
